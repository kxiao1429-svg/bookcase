# 复制成 .env，然后按你的 NAS 改这四项
# 访问口令：手机打开书库时要输，建议 16 位以上，别用 123456
BOOKCASE_TOKEN=请换成你自己的长口令

# NAS 上放电子书的目录，必须是 NAS 上的绝对路径
# 例如 /sata/.storage/books 或 /sata/.storage/个人空间/电子书
BOOKS_DIR=/sata/.storage/books

# 数据库/封面/上传临时文件放这里（也要在 NAS 磁盘上）
DATA_DIR=/sata/.storage/docker/bookcase

# 对外端口和单文件上限（MB）
BOOKCASE_PORT=8765
BOOKCASE_MAX_UPLOAD_MB=4096

# 自动扫描间隔（分钟）：给 FolderSync / Syncthing 自动同步书的场景用，0 = 关闭
BOOKCASE_AUTO_SCAN_MIN=10